# Copy to .env and populate. .env is gitignored — never commit real keys.
STACKOVERFLOW_KEY=
GITHUB_TOKEN=
NVD_KEY=
ANTHROPIC_KEY=

# Optional. Reddit requires an approved OAuth client under its Responsible
# Builder Policy, and commercial use needs a separate agreement. The Reddit
# collector stays dormant while these are blank; nothing else is affected.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
